import numpy as np

student_scores = np.array([
    [80, 75, 90, 85],
    [70, 85, 80, 75],
    [90, 80, 85, 90],
    [85, 90, 95, 80]
])

average = np.mean(student_scores, axis=0)

subjects = ["Math", "Science", "English", "History"]

for i in range(4):
    print(subjects[i], "Average:", average[i])

print("Highest Average Subject:", subjects[np.argmax(average)])
